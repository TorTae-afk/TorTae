    local AIMBOT_RENDER_NAME = "LegitAimbot_Camera"

    local function isLocalInVehicle()
        local char = LocalPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        local seat = hum.SeatPart
        return seat ~= nil and (seat:IsA("VehicleSeat") or seat:IsA("Seat"))
    end

    local function applySmoothLook(cam, aimPos, alpha)
        local pos = cam.CFrame.Position
        local toTarget = aimPos - pos
        if toTarget.Magnitude < 0.05 then return end

        -- Lerp เฉพาะทิศทางการมอง (ไม่ยุ่งตำแหน่งกล้อง) ลดอาการสั่นตอนรถขยับ
        local currentLook = cam.CFrame.LookVector
        local targetLook = toTarget.Unit
        local blendedLook = currentLook:Lerp(targetLook, alpha)
        if blendedLook.Magnitude < 1e-4 then return end
        blendedLook = blendedLook.Unit

        local up = Vector3.yAxis
        if math.abs(blendedLook:Dot(up)) > 0.98 then
            up = cam.CFrame.RightVector
        end

        cam.CFrame = CFrame.lookAt(pos, pos + blendedLook, up)
    end

    local function aimbotStep(deltaTime)
        if not ScriptRunning then return end

        Camera = workspace.CurrentCamera
        if not Camera then return end

        local viewport = Camera.ViewportSize
        local screenCenter = Vector2.new(viewport.X / 2, viewport.Y / 2)

        fovDrawing.Position = screenCenter
        fovDrawing.Radius = FOV_RADIUS
        fovDrawing.Visible = isAimbotEnabled

        if not isAimbotEnabled then
            hideCrosshair()
            return
        end

        local targetPart = getClosestTargetInFov()
        if targetPart then
            local aimPos = targetPart.Position
            local smooth = math.clamp(SMOOTHNESS, 0.001, 1)
            local alpha = smooth >= 1 and 1 or 1 - math.pow(1 - smooth, deltaTime * 60)

            -- ตอนอยู่บนรถกล้องเกมดึงกลับแรง ต้องตอบสนองเร็วขึ้นไม่งั้นจะสั่น
            if isLocalInVehicle() then
                alpha = math.clamp(math.max(alpha * 2.2, 0.35), 0.05, 1)
            end

            applySmoothLook(Camera, aimPos, alpha)

            local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
            if onScreen then
                showCrosshair(Vector2.new(screenPos.X, screenPos.Y))
            else
                hideCrosshair()
            end
        else
            hideCrosshair()
        end
    end

    pcall(function() RunService:UnbindFromRenderStep(AIMBOT_RENDER_NAME) end)
    -- Last = รันหลังกล้องรถ/เกมทุกอย่าง ลดการแย่ง CFrame
    RunService:BindToRenderStep(AIMBOT_RENDER_NAME, Enum.RenderPriority.Last.Value, aimbotStep)

