createBillboardForPlayer = function(player)
    if player == LocalPlayer then return end
    removeESPForPlayer(player)

    local function setupESP(character)
        local rootPart = character:WaitForChild("HumanoidRootPart", 5)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not rootPart or not humanoid then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.FillTransparency = 0.85 
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop 
        highlight.Adornee = character
        highlight.Parent = character

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Billboard"
        billboard.Adornee = rootPart
        billboard.Size = UDim2.new(0, 150, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0) 
        billboard.AlwaysOnTop = true
        billboard.Parent = rootPart

        local listLayout = Instance.new("UIListLayout")
        listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 2)
        listLayout.Parent = billboard

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 14)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextStrokeTransparency = 0 
        nameLabel.Font = Enum.Font.SourceSansBold
        nameLabel.TextSize = 13
        nameLabel.Parent = billboard

        local healthBG = Instance.new("Frame")
        healthBG.Size = UDim2.new(0, 80, 0, 5)
        healthBG.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        healthBG.BorderSizePixel = 0
        healthBG.Parent = billboard
        Instance.new("UICorner", healthBG).CornerRadius = UDim.new(1, 0)

        local healthBar = Instance.new("Frame")
        healthBar.Size = UDim2.new(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 0, 1, 0)
        healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        healthBar.BorderSizePixel = 0
        healthBar.Parent = healthBG
        Instance.new("UICorner", healthBar).CornerRadius = UDim.new(1, 0)

        local hpChanged = humanoid.HealthChanged:Connect(function(health)
            local pct = math.clamp(health / humanoid.MaxHealth, 0, 1)
            TweenService:Create(healthBar, TweenInfo.new(0.1), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
            if pct < 0.3 then
                healthBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            else
                healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            end
        end)

        BillboardCache[player.UserId] = {
            Character = character,
            Connection = hpChanged
        }
    end

    if player.Character then setupESP(player.Character) end
    local charAdded = player.CharacterAdded:Connect(setupESP)
    PlayerESP_UpdateConnections[player.UserId] = charAdded
end

removeESPForPlayer = function(player)
    if player.Character then
        local oldHighlight = player.Character:FindFirstChild("ESP_Highlight")
        if oldHighlight then oldHighlight:Destroy() end
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local oldBillboard = root:FindFirstChild("ESP_Billboard")
            if oldBillboard then oldBillboard:Destroy() end
        end
    end
    if BillboardCache[player.UserId] then
        if BillboardCache[player.UserId].Connection then
            BillboardCache[player.UserId].Connection:Disconnect()
        end
        BillboardCache[player.UserId] = nil
    end
    if PlayerESP_UpdateConnections[player.UserId] then
        PlayerESP_UpdateConnections[player.UserId]:Disconnect()
        PlayerESP_UpdateConnections[player.UserId] = nil
    end
end

