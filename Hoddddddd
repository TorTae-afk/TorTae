local function StartAimbotScript()
    local Mouse = LocalPlayer:GetMouse() 
    local Camera = workspace.CurrentCamera
    local UserInputService = game:GetService("UserInputService")

    -- DEFAULT CONFIGURATION (Aimbot)
    local SMOOTHNESS = 0.15
    local FOV_RADIUS = 150    
    local WallCheckEnabled = true 
    local WhitelistedPlayers = {} 

    local TOGGLE_GUI_KEY = Enum.KeyCode.Insert
    -- Aim bind รองรับทั้งคีย์บอร์ดและเมาส์ (Left / Right / Middle)
    local AIM_BIND = { Kind = "Key", Value = Enum.KeyCode.Z }
    local AIM_MODE = "Toggle"

    local isAimbotEnabled = true
    local ScriptRunning = true

    local MOUSE_BIND_NAMES = {
        [Enum.UserInputType.MouseButton1] = "Mouse1",
        [Enum.UserInputType.MouseButton2] = "Mouse2",
        [Enum.UserInputType.MouseButton3] = "Mouse3",
    }

    local function getAimBindName()
        if AIM_BIND.Kind == "Mouse" then
            return MOUSE_BIND_NAMES[AIM_BIND.Value] or AIM_BIND.Value.Name
        end
        return AIM_BIND.Value.Name
    end

    local function isAimBindInput(input)
        if AIM_BIND.Kind == "Mouse" then
            return input.UserInputType == AIM_BIND.Value
        end
        return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == AIM_BIND.Value
    end

    ----------------------------------------------------------------
    -- 💾 SAVE / LOAD CONFIGURATIONS
    ----------------------------------------------------------------
    local function SaveConfig()
        local config = {
            Smoothness = SMOOTHNESS,
            FovRadius = FOV_RADIUS,
            WallCheck = WallCheckEnabled,
            Whitelist = WhitelistedPlayers,
            AimKey = getAimBindName(),
            AimBindKind = AIM_BIND.Kind,
            AimBindValue = AIM_BIND.Value.Name,
            AimMode = AIM_MODE
        }
        local success, jsonStr = pcall(function() return HttpService:JSONEncode(config) end)
        if success and writefile then
            writefile(FILE_NAME, jsonStr)
            return true
        end
        return false
    end

    local function LoadConfig()
        if readfile and isfile and isfile(FILE_NAME) then
            local success, jsonStr = pcall(function() return readfile(FILE_NAME) end)
            if success and jsonStr then
                local success2, config = pcall(function() return HttpService:JSONDecode(jsonStr) end)
                if success2 and config then
                    if config.Smoothness ~= nil then
                        SMOOTHNESS = math.clamp(tonumber(config.Smoothness) or SMOOTHNESS, 0.001, 1)
                    end
                    if config.FovRadius ~= nil then FOV_RADIUS = config.FovRadius end
                    if config.WallCheck ~= nil then WallCheckEnabled = config.WallCheck end
                    if config.AimBindKind == "Mouse" and type(config.AimBindValue) == "string" then
                        local mouseType = Enum.UserInputType[config.AimBindValue]
                        if mouseType and MOUSE_BIND_NAMES[mouseType] then
                            AIM_BIND = { Kind = "Mouse", Value = mouseType }
                        end
                    elseif type(config.AimKey) == "string" then
                        if config.AimKey == "Mouse1" then
                            AIM_BIND = { Kind = "Mouse", Value = Enum.UserInputType.MouseButton1 }
                        elseif config.AimKey == "Mouse2" then
                            AIM_BIND = { Kind = "Mouse", Value = Enum.UserInputType.MouseButton2 }
                        elseif config.AimKey == "Mouse3" then
                            AIM_BIND = { Kind = "Mouse", Value = Enum.UserInputType.MouseButton3 }
                        else
                            local loadedKey = Enum.KeyCode[config.AimKey]
                            if loadedKey and loadedKey ~= Enum.KeyCode.Unknown then
                                AIM_BIND = { Kind = "Key", Value = loadedKey }
                            end
                        end
                    end
                    if config.AimMode == "Toggle" or config.AimMode == "Hold" then
                        AIM_MODE = config.AimMode
                    end
                    if config.Whitelist ~= nil and type(config.Whitelist) == "table" then 
                        WhitelistedPlayers = config.Whitelist 
                    end
                end
            end
        end
    end

    LoadConfig()

    ----------------------------------------------------------------
    -- 🟢 DRAWING API (FOV RAD)
    ----------------------------------------------------------------
    local fovDrawing = Drawing.new("Circle")
    fovDrawing.Visible = true
    fovDrawing.Color = Color3.fromRGB(255, 255, 255)
    fovDrawing.Thickness = 1
    fovDrawing.NumSides = 64
    fovDrawing.Radius = FOV_RADIUS
    fovDrawing.Filled = false
    fovDrawing.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local crossHairHorizontal = Drawing.new("Line")
    crossHairHorizontal.Visible = false
    crossHairHorizontal.Color = Color3.fromRGB(255, 0, 0)
    crossHairHorizontal.Thickness = 2

    local crossHairVertical = Drawing.new("Line")
    crossHairVertical.Visible = false
    crossHairVertical.Color = Color3.fromRGB(255, 0, 0)
    crossHairVertical.Thickness = 2

    local function hideCrosshair()
        crossHairHorizontal.Visible = false
        crossHairVertical.Visible = false
    end

    local function showCrosshair(screenPos)
        local size = 8
        crossHairHorizontal.From = Vector2.new(screenPos.X - size, screenPos.Y)
        crossHairHorizontal.To = Vector2.new(screenPos.X + size, screenPos.Y)
        crossHairHorizontal.Visible = true
        crossHairVertical.From = Vector2.new(screenPos.X, screenPos.Y - size)
        crossHairVertical.To = Vector2.new(screenPos.X, screenPos.Y + size)
        crossHairVertical.Visible = true
    end

    ----------------------------------------------------------------
    -- 🧱 WALL CHECK FUNCTION 
    ----------------------------------------------------------------
    local function isPlayerVisible(targetChar, targetPart)
        if not WallCheckEnabled then return true end 
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
        
        local origin = Camera.CFrame.Position
        local destination = targetPart.Position
        local direction = destination - origin
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetChar}
        raycastParams.IgnoreWater = true
        
        local raycastResult = workspace:Raycast(origin, direction, raycastParams)
        
        if raycastResult then
            return false -- มีสิ่งกีดขวาง/กำแพง บังอยู่
        end
        return true
    end

    ----------------------------------------------------------------
    -- 🎯 AIMBOT TARGETING (FOV คงที่กลางจอ)
    ----------------------------------------------------------------
    local function getClosestTargetInFov()
        local viewport = Camera.ViewportSize
        local screenCenter = Vector2.new(viewport.X / 2, viewport.Y / 2)
        local closestPart = nil
        local shortestDist = FOV_RADIUS

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not table.find(WhitelistedPlayers, player.Name) then
                local char = player.Character
                if char then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    local head = char:FindFirstChild("Head")
                    if humanoid and humanoid.Health > 0 and head then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if dist <= shortestDist and isPlayerVisible(char, head) then
                                shortestDist = dist
                                closestPart = head
                            end
                        end
                    end
                end
            end
        end

        return closestPart
    end

    ----------------------------------------------------------------
    -- 🛠️ MODERN UI GENERATION
    ----------------------------------------------------------------
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ModernAimbotGui"
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
