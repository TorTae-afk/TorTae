    local function beginFovDrag() draggingFov = true end
    local function beginSmoothDrag() draggingSmooth = true end

    FovBtn.MouseButton1Down:Connect(beginFovDrag)
    SmoothBtn.MouseButton1Down:Connect(beginSmoothDrag)
    FovBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then beginFovDrag() end
    end)
    SmoothBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then beginSmoothDrag() end
    end)

    local inputEndedConn = UserInputService.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 then 
            draggingFov = false 
            draggingSmooth = false 
        end 
    end)
    table.insert(GlobalConnections, inputEndedConn)

    local inputChangedConn = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

        if draggingFov then
            local absPos = FovBg.AbsolutePosition.X
            local absSize = math.max(FovBg.AbsoluteSize.X, 1)
            local pct = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
            FOV_RADIUS = math.floor(10 + pct * 400)
            fovDrawing.Radius = FOV_RADIUS
            lblFov.Text = "ระยะล็อกเป้า (FOV Radius): " .. FOV_RADIUS
            FovFill.Size = UDim2.new(pct, 0, 1, 0)
            FovBtn.Position = UDim2.new(pct, -6, 0.5, -6)
        end

        if draggingSmooth then
            local absPos = SmoothBg.AbsolutePosition.X
            local absSize = math.max(SmoothBg.AbsoluteSize.X, 1)
            local pct = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
            SMOOTHNESS = math.floor((0.001 + pct * 0.999) * 1000 + 0.5) / 1000
            lblSmooth.Text = "ความเนียน (Smoothness): " .. string.format("%.3f", SMOOTHNESS)
            SmoothFill.Size = UDim2.new(pct, 0, 1, 0)
            SmoothBtn.Position = UDim2.new(pct, -6, 0.5, -6)
        end
    end)
    table.insert(GlobalConnections, inputChangedConn)

